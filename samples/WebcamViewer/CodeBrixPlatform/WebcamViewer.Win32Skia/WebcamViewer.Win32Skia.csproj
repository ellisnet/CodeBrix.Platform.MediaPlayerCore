<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <!-- CodeBrix.Platform needs this define for its internal conditional compilation -->
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI</DefineConstants>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform (Uno-style) XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (linked from WebcamViewer.UI) -->
  <Import Project="..\WebcamViewer.UI\WebcamViewer.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\WebcamViewer.Core\WebcamViewer.Core.csproj" />
  </ItemGroup>

  <!--
    Platform-specific package: Skia backend for Windows desktops hosted in a Win32 window.
    All other packages come from WebcamViewer.Core.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.Win32.ApacheLicenseForever" Version="1.0.186.1273" />
  </ItemGroup>
  <!-- Native libvlc runtime for CodeBrix.Webcam: the VideoLAN package lays the
       libvlc binaries + plugins into the output folder on Windows. -->
  <ItemGroup>
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
</Project>
