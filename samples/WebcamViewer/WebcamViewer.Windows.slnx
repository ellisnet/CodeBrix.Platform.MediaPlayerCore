<Solution>
  <!-- WebcamViewer.Windows.slnx
       The Windows-only solution: everything in WebcamViewer.slnx PLUS the
       native (non-Skia) WinUI 3 and WPF heads, which require Windows-host-only
       build tooling. Open this one on a Windows machine. -->
  <!-- WebcamViewer.WinUI only declares Platforms x86/x64/ARM64 (no Any CPU),
       so the solution platforms are restricted to match - otherwise VS offers
       "Any CPU" and fails to map it to the WinUI project. -->
  <Configurations>
    <Platform Name="x86" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="README.md" />
  </Folder>
  <Folder Name="/CodeBrixPlatform/">
    <Project Path="CodeBrixPlatform/WebcamViewer.UI/WebcamViewer.UI.shproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.Core/WebcamViewer.Core.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.Win32Skia/WebcamViewer.Win32Skia.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.WinWpfSkia/WebcamViewer.WinWpfSkia.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.LinuxX11/WebcamViewer.LinuxX11.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.LinuxWayland/WebcamViewer.LinuxWayland.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.LinuxFrameBuffer/WebcamViewer.LinuxFrameBuffer.csproj" />
    <Project Path="CodeBrixPlatform/WebcamViewer.MacOS/WebcamViewer.MacOS.csproj" />
  </Folder>
  <Project Path="../../src/CodeBrix.MediaCore/CodeBrix.MediaCore.csproj" />
  <Project Path="../../src/CodeBrix.Webcam/CodeBrix.Webcam.csproj" />
  <Project Path="WebcamViewer.WinUI/WebcamViewer.WinUI.csproj">
    <Platform Solution="*|x86" Project="x86" />
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|ARM64" Project="ARM64" />
    <Deploy Solution="Debug|ARM64" />
    <Deploy Solution="Debug|x64" />
  </Project>
  <Project Path="WebcamViewer.Wpf/WebcamViewer.Wpf.csproj" />
</Solution>
