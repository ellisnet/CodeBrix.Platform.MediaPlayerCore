<Window x:Class="WebcamViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WebcamViewer.ViewModels"
        xmlns:video="clr-namespace:WebcamViewer.Video"
        Title="Webcam Viewer" Height="720" Width="960">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Webcam Viewer" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <ComboBox MinWidth="280" VerticalAlignment="Center"
                      ItemsSource="{Binding Cameras}"
                      SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" />
            <CheckBox Content="Monitor audio" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding IsAudioMonitorOn, Mode=TwoWay}"
                      IsEnabled="{Binding IsMicAvailable}" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="Black">
            <video:VideoCanvas x:Name="VideoView" />
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folder Path:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Padding="4,2" />
            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseFolderCommand}"
                    Margin="8,0,0,0" MinWidth="100" Padding="8,4" />
            <Button Grid.Column="3" Content="Photo" Command="{Binding PhotoCommand}"
                    Margin="8,0,0,0" MinWidth="100" Padding="8,4" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
