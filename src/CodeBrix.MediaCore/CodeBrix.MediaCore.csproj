<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.MediaCore</AssemblyName>
    <!--
        DELIBERATE MISMATCH — DO NOT "FIX".

        The types in this project keep their original
        CodeBrix.Platform.MediaPlayerCore namespaces (and sub-namespaces)
        even though the assembly/package is named CodeBrix.MediaCore. They
        were moved here verbatim from the CodeBrix.Platform.MediaPlayerCore
        project so that existing consumers (the CodeBrix.Platform MediaPlayer
        add-in) keep compiling with ZERO source changes. Renaming the
        namespaces to CodeBrix.MediaCore.* would be a breaking change and is
        not allowed. RootNamespace below matches the namespaces actually used
        in the sources.
      -->
    <RootNamespace>CodeBrix.Platform.MediaPlayerCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
      IMPORTANT — DELIBERATE EXCEPTION TO THE NORMAL CODEBRIX VERSIONING SCHEME.

      The MAJOR version of CodeBrix.MediaCore MUST match the MAJOR version of
      the native libvlc library it wraps. This library is a port of
      LibVLCSharp 3.9.7, which targets libvlc 3.x — therefore the managed
      package's MAJOR is pinned at 3.

      At runtime, Core.EnsureVersionsMatch() (see Core/Core.cs) reads
      Assembly.GetExecutingAssembly().GetName().Version.Major and throws
      VLCException if it does not equal the native libvlc major version.
      Bumping MAJOR to anything other than libvlc's major will make every
      LibVLC instantiation throw.

      The normal CodeBrix standard of setting the Major version to 1 does not
      apply to this library/package. Only bump MAJOR here when (and if) this
      library is re-ported from a future LibVLCSharp that targets a newer libvlc
      major — e.g. LibVLCSharp 4.x against libvlc 4.x, at which point bump to 4.0.x
      and update the rationale in THIRD-PARTY-NOTICES.txt.

      ALL packages produced by this repo (CodeBrix.MediaCore,
      CodeBrix.Platform.MediaPlayerCore, and eventually CodeBrix.Webcam) share
      this same 3.x.y.z scheme and always build/ship together at (effectively)
      the same version.

      Note that the next comment is the "standard" version explainer comment and
      has not been modified, so it still talks about setting to the major version
      to 1, but this can be ignored for this library/package.

      Also note that the only change to the versioning <PropertyGroup> below -
      which takes it away from the "standard" CodeBrix XML is that the
      <BuildVersion> take has a "3." instead of a "1."
    -->

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>3.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!-- NuGet package properties -->
  <PropertyGroup>
    <PackageId>CodeBrix.MediaCore.LgplLicenseForever</PackageId>
    <Product>CodeBrix.MediaCore</Product>
    <Title>CodeBrix.MediaCore</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed, cross-platform media engine for .NET 10: the libvlc binding underneath the CodeBrix media libraries (LibVLC, Media, MediaPlayer, VideoFrameSink, discoverers, equalizer, dialogs).</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Platform.MediaPlayerCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Platform.MediaPlayerCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors.</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>video;audio;media;engine;player;webcam;libvlc;vlc;streaming;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
