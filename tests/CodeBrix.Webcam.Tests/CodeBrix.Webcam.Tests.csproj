<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
    <!-- No libvlc package: CodeBrix.Webcam uses the built-in Media Foundation
         engine on Windows, and on macOS the engine loads /Applications/VLC.app
         (universal). The VideoLAN.LibVLC.Mac package is x64-only and lacks the
         imem plugin, and when present in the output folder it wins over VLC.app. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Webcam\CodeBrix.Webcam.csproj" />
  </ItemGroup>

</Project>
